{
  "name": "mycrm",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "functions",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm --workspace apps/server run dev\" \"npm --workspace apps/web run dev\"",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:server": "npm --workspace apps/server run dev",
    "test:server": "npm --workspace apps/server run test",
    "build:server": "npm --workspace apps/server run build",
    "build": "npm --workspace apps/web run build",
    "preview": "npm --workspace apps/web run preview",
    "seed": "tsx scripts/seed.ts",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "functions:build": "npm --workspace functions run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
