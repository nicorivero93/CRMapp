{
  "name": "@mycrm/server",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "bundle": "tsx packaging/build-bundle.ts",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/build-release.ps1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "csv-parse": "^5.5.6",
    "libphonenumber-js": "^1.11.13",
    "node-cron": "^3.0.3",
    "@mycrm/db": "*",
    "@mycrm/shared": "*",
    "@node-rs/argon2": "^2.0.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "esbuild": "^0.24.0",
    "postject": "^1.0.0-alpha.6",
    "drizzle-kit": "^0.28.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
